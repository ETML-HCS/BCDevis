{
  "name": "bellecour-devis-portable",
  "version": "4.20.0",
  "private": true,
  "author": "Clinique Bellecour",
  "description": "Bellecour Devis, application Windows portable autonome.",
  "main": "devis-portable/main.cjs",
  "scripts": {
    "test": "node devis-portable/tests/core.test.cjs && node devis-portable/tests/pdf-main.test.cjs",
    "check": "node --check devis-portable/app.js && node --check devis-portable/main.cjs && node --check devis-portable/preload.cjs && npm test",
    "start": "electron .",
    "exe": "npm run check && npm run build:portable",
    "build:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ch.cliniquebellecour.devis",
    "productName": "Bellecour Devis",
    "asar": true,
    "directories": {
      "output": "devis-portable/dist"
    },
    "files": [
      "devis-portable/**",
      "!devis-portable/data/**",
      "!devis-portable/dist/**",
      "!devis-portable/tests/**",
      "!devis-portable/captures/**",
      "!devis-portable/tmp/**",
      "!devis-portable/Lancer Bellecour Devis.cmd",
      "!devis-portable/README.md",
      "!devis-portable/index-*.html"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
