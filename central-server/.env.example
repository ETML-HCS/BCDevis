POSTGRES_DB=bcdevis
POSTGRES_USER=bcdevis
POSTGRES_PASSWORD=remplacer-par-un-secret-postgresql-long

BCDEVIS_ORGANIZATION=Clinique Bellecour
BCDEVIS_ADMIN_EMAIL=admin@cliniquebellecour.ch
BCDEVIS_ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-compte-long
BCDEVIS_ALLOWED_ORIGINS=null,https://etml-hcs.github.io
BCDEVIS_SESSION_DAYS=30

# Activez cette option uniquement derrière une configuration PostgreSQL TLS
# dont le certificat est reconnu par le système du conteneur.
BCDEVIS_DATABASE_SSL=false
