{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "*": ["types/*"]
    }
  },
  "include": [
    "devis-portable/**/*",
    "central-server/**/*",
    "scripts/**/*",
    "types/**/*"
  ],
  "exclude": [
